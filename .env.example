# Hyperliquid API Configuration
# Másold át ezt a fájlt .env néven és töltsd ki a valódi értékekkel

# Agent Wallet (API aláíráshoz)
HL_AGENT_PRIVATE_KEY=your_private_key_here
HL_AGENT_WALLET_ADDRESS=0xYourAgentWalletAddress

# Trading Account (pozíciók és egyenleg lekérdezéséhez)
HL_TRADING_ADDRESS=0xYourTradingAddress

# Opcionális: CryptoPanic API kulcs
CRYPTO_PANIC_KEY=your_crypto_panic_key_here

# Opcionális: Ollama LLM beállítások
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b